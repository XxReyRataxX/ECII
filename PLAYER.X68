	DC.L 27, 27, 27, 27, 27, 27, 27, 27, 27, 27, 27, 27, 27, 27, 27
	DC.L 27, 27, 27, 27, 28, 28, 28, 28, 28, 28, 28, 28, 28, 28, 28
	DC.L 28, 28, 28, 28, 28, 28, 28, 28, 28, 28, 28, 28, 28, 28, 28
	DC.L 28, 28, 29, 29, 29, 29, 29, 29, 29, 29, 29, 29, 29, 29, 29
	DC.L 29, 29, 29, 29, 29, 29, 29, 29, 29, 29, 29, 29, 29, 29, 29
	DC.L 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30
	DC.L 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 31, 31
	DC.L 31, 31, 31, 31, 31, 31, 31, 31, 31, 31, 31, 31, 31, 31, 31
	DC.L 31, 31, 31, 31, 31, 31, 31, 31, 31, 31, 31
    
; ==============================================================================
; SYSTEM VARIABLES
; ==============================================================================
PLRWIDTH    EQU     30                      ; PLAYER WIDTH (PIXELS)
PLRHEIGH    EQU     30                      ; PLAYER HEIGHT (PIXELS)


          
; --- KEYBOARD RELATED VARIABLES -----------------------------------------------
KBDTRAP     EQU     0                       ; KEYBOARD UPDATE TRAP

KBDVAL      DS.B    1                       ; KEY STATE
KBDEDGE     DS.B    1                       ; KEY EDGE

KBDDOWN     EQU     'S'
KBDRIGHT    EQU     'D'
KBDUP       EQU     'W'
KBDLEFT     EQU     'A'
KBDESC      EQU     $20                     ; SPACE KEY (ESCUDO)
; --- TIMED INTERRUPT RELATED VARIABLES ----------------------------------------

SCRINTCT    DS.B    1                       ; INTERRUPT COUNTER
SCRCYCCT    DS.B    1                       ; CYCLE COUNTER
            DS.W    0

; --- GAME STATE RELATED VARIABLES --------------------------------------------

STACUR      DS.W    1                       ; CURRENT GAME STATE
STANEXT     DS.W    1                       ; NEXT GAME STATE

; --- BALL RELATED VARIABLES ---------------------------------------------------

BALPOSX     DS.W    1                       ; BALL X COORDINATE
BALPOSY     DS.W    1                       ; BALL Y COORDINATE
BALVELX     DS.W    1                       ; BALL X VELOCITY
BALVELY     DS.W    1                       ; BALL Y VELOCITY

; --- PLAYER RELATED VARIABLES ------------------------------------------------

PLRPOSX     DS.W    1                       ; PLAYER X POSITION (PIXELS)
PLRPOSY     DS.W    1                       ; PLAYER Y POSITION (PIXELS)
PLRENER     DS.W    1                       ; PLAYER ENERGY
PLRDMG      DS.B    1                       ; BIT0: UPD DAMAGE, BIT1 PLOT DMG
            DS.W    0
PLRSPEED    EQU     6    
            
; --- ESCUDO RELATED VARIABLES ----------------------------------------------------

ESCPOSX     DS.W 1                          ;POSICION Y ESCUDO
ESCPOSY     DS.W 1                          ;POSICION Y ESCUDO

; --- SCREEN RELATED VARIABLES ---------------------------------------------
SCRWIDTH    EQU     640                     ; SCREEN WIDTH (PIXELS)
SCRHEIGH    EQU     480                     ; SCREEN HEIGHT (PIXELS)
SCRIRQ      EQU     1                       ; SCREEN INTERRUPT NUMBER
TIMER       DC.B    'TIMER: ',0
VTIMER      DS.W    1
POINT       DS.W    1                          ;PUNTOS CONSEGUIDOS     
SCRTRAP     EQU     1

;-----------------MOUSE DECLARATIONS----------
MOUSETRAP   EQU     2
ENATP       DS.W    1
LASTENA     DS.W    1
START:                  ; first instruction of program
           CLR.L VTIMER
            JSR SCRINIT
           JSR KBDINIT
	   JSR MOUSEINIT

           JSR PLRINIT
           CLR.L D2
.LOOP       
            TRAP    #MOUSETRAP
	    TRAP    #KBDTRAP                ; READ KEYBOARD
            JSR     PLRUPD

            JSR     DIBUJAR
            
.WINT       TST.B   (SCRINTCT)              ; WAIT FOR INTERRUPT
            BEQ     .WINT
            CLR.B   (SCRINTCT)
            CLR.L D6
            MOVE.B (SCRCYCCT),D6
            CMP #50,D6
            BNE .YA
            ADDQ.W #1,(VTIMER)
            CLR.B   (SCRCYCCT)
.YA           
            TRAP    #SCRTRAP                ; SHOW GRAPHICS                
            
            BRA .LOOP
    SIMHALT             ; halt simulator
SCRISR
; SCREEN TIMER ISR. INCREASES THE INTERRUPT COUNTER AND UPDATES DOUBLE BUFFER.
; INPUT    - NONE
; OUTPUT   - NONE
; MODIFIES - NONE
; -----------------------------------------------------------------------------
            ADDQ.B  #1,(SCRINTCT)           ; UPDATE INT FLAG/COUNTER
            ADDQ.B  #1,(SCRCYCCT)           ; UPDATE CYCLE COUNTER
            RTE
SCRINIT
            ORI.W   #$0700,SR               ; DISABLE ALL INT
            MOVE.L  #SCRUPD,($80+SCRTRAP*4) ; INSTALL TRAP
            MOVE.L  #SCRWIDTH<<16|SCRHEIGH,D1 ; SET RESOLUTION
            MOVE.B  #33,D0
            TRAP    #15
            MOVE.L  #1,D1                   ; SET WINDOWED MODE
            TRAP    #15
            MOVE.W  #$FF00,D1               ; CLEAR VISIBLE BUFFER
            MOVE.B  #11,D0
            TRAP    #15
            MOVE.B  #17,D1                  ; ENABLE DOUBLE BUFFER
            MOVE.B  #92,D0
            TRAP    #15
            MOVE.W  #$FF00,D1               ; CLEAR HIDDEN BUFFER
            MOVE.B  #11,D0
            TRAP    #15
            MOVE.L  #SCRISR,($64)       ; 60+SCRIRQ*4)  ; SET EXCEPTION VECTOR
            MOVE.B  #5,D1                   ; ENABLE EXCEPTION PROCESSING
            MOVE.B  #32,D0
            TRAP    #15
           ; ENABLE TIMED INTERRUPT
            MOVE.B  #32,D0
            MOVE.B  #6,D1
            MOVE.B  #$81,D2
            MOVE.L  #20,D3
            TRAP    #15
            
            
            CLR.B   (SCRINTCT)              ; PREPARE INTERRUPT FLAG
            CLR.B   (SCRCYCCT) 
            ANDI.W  #$F8FF,SR               ; ENABLE INTS            
            RTS 
* Put variables and constants here
KBDREAD
; TRAP SERVICE ROUTINE.
; UPDATES THE SYSTEM VARIABLES KBDEDGE AND KBDVAL ACCORDING TO THE BITFIELD
; DESCRIBED IN SYSCONST. KBDVAL HOLDS THE CURRENT VALUES AND KBDEFGE HOLDS
; RISING EDGES FROM PREVIOUS CALL TO THE CURRENT ONE.
; INPUT    - NONE
; OUTPUT   - (KBDVAL) AND (KBDEDGE)
; MODIFIES - NONE
; -----------------------------------------------------------------------------
            MOVEM.L D0-D3,-(A7)
            MOVE.B  #19,D0
            MOVE.L  #KBDDOWN<<24+KBDRIGHT<<16+KBDUP<<8+KBDLEFT,D1
            TRAP    #15
            BSR     .STORE                  ; STORE KEY UP,DOWN,LEFT AND RIGTH.
            MOVE.B  (KBDVAL),D0             ; COMPUTE EDGE.
            NOT.B   D0                      ; EDGE=NOT(PREVIOUS) AND CURRENT.
            AND.B   D2,D0
            MOVE.B  D2,(KBDVAL)             ; STORE VALUES (PRESS AND EDGE)
            MOVE.B  D0,(KBDEDGE)
            MOVEM.L (A7)+,D0-D3
            RTE

.STORE      MOVE.W  #3,D3                   ; TRANSLATES THE 8-BIT ENCODING
.LOOP       LSL.L   #8,D1                   ; OF TRAP #15 TASK 19 INTO A 1-BIT
            ROXL.B  #1,D2                   ; PER KEYPRESS ENCODING
            DBRA.W  D3,.LOOP
            RTS
KBDINIT     
    ; INITIALIZES THE SYSTEM VARIABLES KBDSYS AND KBDVAL
; INPUT    - NONE
; OUTPUT   - NONE
; MODIFIES - NONE
; -----------------------------------------------------------------------------
            CLR.B   (KBDVAL)                    ; INIT VARS
            CLR.B   (KBDEDGE)
            MOVE.L  #KBDREAD, ($80+KBDTRAP*4)    ; INSTALL
            RTS
PLRINIT            
;Personaje 
;----------------------------------------------------------------------------            
            MOVE.W  #PLRWIDTH/2,(PLRPOSX)
            MOVE.W  #(SCRHEIGH-PLRHEIGH)/2,(PLRPOSY)
            RTS
            
PLRUPD
; UPDATES THE PLAYER MOTION
; INPUT    - NONE (ACCESSES KBDVAL AND KBDEDGE)
; OUTPUT   - NONE (MODIFIES PLAYER DATA)
; MODIFIES - NONE
; -----------------------------------------------------------------------------
            MOVE.W  D1,-(A7)
            
            
            MOVE.B  (KBDVAL),D1             ; PERFORM MOTION AND CHECK BOUNDS.
            
            ADD.W   #2,(PLRPOSY)
            ROR.B   #1,D1
            BCC     .CHKUP
            SUB.W   #PLRSPEED,(PLRPOSX)
            TST.W   (PLRPOSX)
            BGE     .CHKUP
            CLR.W   (PLRPOSX)
.CHKUP      ROR.B   #1,D1
            BCC     .CHKRT
            
            SUB.W   #PLRSPEED,(PLRPOSY) 
            
            TST.W   (PLRPOSY)
            BGE     .CHKRT
            CLR.W   (PLRPOSY)
.CHKRT      ROR.B   #1,D1
            BCC     .CHKDN
            ADD.W   #PLRSPEED,(PLRPOSX)
            CMP.W   #SCRWIDTH-PLRWIDTH,(PLRPOSX)
            BLE     .CHKDN
            MOVE.W  #SCRWIDTH-PLRWIDTH,(PLRPOSX)
.CHKDN      ROR.B   #1,D1
            BCC     .MDONE
            ADD.W   #PLRSPEED,(PLRPOSY)
            CMP.W   #SCRHEIGH-PLRHEIGH,(PLRPOSY)
            BLE     .MDONE
            MOVE.W  #SCRHEIGH-PLRHEIGH,(PLRPOSY)
.MDONE      
            
            
            MOVE.W  (A7)+,D1
            RTS
DIBUJAR     ;DIBUJAMOS DESDE 0,0 HASTA A SABER DONDE
            MOVEM.L D0-D6,-(A7)
            MOVEM.L A0-A1,-(A7)
            
            LEA TIMER,A1
            CLR.L D1
            CLR.L D0
            MOVE.W (VTIMER),D1
            MOVE.B #17,D0
            TRAP #15
            MOVE.W (PLRPOSX),D5
            MOVE.W (PLRPOSY),D6
            LEA PIXEL,A0
            LEA X,A1
            LEA Y,A2
            MOVE.W #896,D4
            SUBQ.W #1,D4
            
            
            
LOOPDIB:
            
            MOVE.B #80,D0
            MOVE.L (A0)+,D1
            TRAP #15 ;PEN COLOR
            MOVE.B #82,D0
            MOVE.L (A1)+,D1
            MOVE.L (A2)+,D2
            ADD.L D5,D1
            ADD.L D6,D2
            
            TRAP #15 ;Dibujar pixel
            DBRA D4,LOOPDIB
            
            MOVEM.L (A7)+,D0-D6
            MOVEM.L (A7)+,A0-A1
            RTS
MOUSEINIT     
    ; INITIALIZES THE SYSTEM VARIABLES KBDSYS AND KBDVAL
; INPUT    - NONE
; OUTPUT   - NONE
; MODIFIES - NONE
; -----------------------------------------------------------------------------
            CLR.W   (MOUSEPOSX)                    ; INIT VARS
            CLR.W   (MOUSEPOSY)
            CLR.W   (ENATP)
            CLR.W   (LASTENA)
	
            MOVE.L  #REVISION, ($80+MOUSETRAP*4)    ; INSTALL
            RTS
            
REVISION:
            MOVEM.L D0-D7,-(A7)

	; READ CURRENT STATE OF MOUSE AND CHANGE MOUSE COORDINATES
	MOVE.B  #61,D0
	MOVE.B  #00,D1
	
	TRAP    #15
            MOVE.W  D1,(MOUSEPOSX)
            

            
	

            SWAP    D1            ; Intercambia los 16 bits superiores e inferiores de D1

            MOVE.W  D1,(MOUSEPOSY)
            SWAP    D1
	

	; IF LEFT CLICK PRESSED AND IT'S INSIDE THE BUTTON ADD 1
	BTST    #0,D0
	
            BEQ     NOT_PRESSED
            CMP.W   #0,(ENATP)
            BNE CHECKTIMER

PRESSED:
            MOVE.W (VTIMER),(LASTENA)
            MOVE.W (MOUSEPOSX),(PLRPOSX)
            MOVE.W (MOUSEPOSY),(PLRPOSY)
            MOVE.W #1,(ENATP)
	BRA     NOT_PRESSED

CHECKTIMER:
            MOVE.W (VTIMER),D3
            SUB.W (LASTENA),D3
            
            CMP #2,D3
            BNE NOT_PRESSED
            CLR.W (ENATP)
            
         
NOT_PRESSED:          
	MOVEM.L  (A7)+,D0-D7
	RTE
	
           
; -----------------------------------------------------------------------------
SCRUPD
; TRAP SERVICE ROUTINE IN CHARGE OF VISUALIZING CURRENT FRAME AND CLEARING
; BUFFER FOR THE NEXT ONE.
; INPUT    - NONE
; OUTPUT   - NONE
; MODIFIES - NONE
; -----------------------------------------------------------------------------
            MOVEM.W D0-D1,-(A7)
            MOVE.B  #94,D0                  ; UPDATE DOUBLE BUFFER
            TRAP    #15
            MOVE.W  #$FF00,D1               ; CLEAR HIDDEN BUFFER
            MOVE.B  #11,D0
            TRAP    #15
            MOVEM.W (A7)+,D0-D1
            RTE
    END    START        ; last line of source











