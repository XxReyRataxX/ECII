PLRWIDTH    EQU     30                      ; PLAYER WIDTH (PIXELS)
PLRHEIGH    EQU     30                      ; PLAYER HEIGHT (PIXELS)


; --- PLAYER RELATED CONST -----------------------------------------------

PLRWIDTH    EQU     30                      ; PLAYER WIDTH (PIXELS)
PLRHEIGH    EQU     30                      ; PLAYER HEIGHT (PIXELS)
PLRSPEEDX    EQU     6
PLRSPEEDY    EQU     20

GRAVEDAD    EQU    2                        ;GRAVEDAD CONSTANTE QUE SIMPRE HARA QUE EL PERSONAJE CAIGA         
; --- KEYBOARD RELATED CONSTS -----------------------------------------------
KBDTRAP     EQU     0                       ; KEYBOARD UPDATE TRAP

KBDDOWN     EQU     'S'
KBDRIGHT    EQU     'D'
KBDUP       EQU     'W'
KBDLEFT     EQU     'A'
KBDSHIELD   EQU     $20



; --- BALL RELATED VARIABLES ---------------------------------------------------


BALVEL      EQU     3
BALRAD      EQU     20
BALPRV1     DS.W    1
BALPRV2     DS.W    1

    
; --- SCREEN RELATED CONSTS ---------------------------------------------
SCRWIDTH    EQU     640                     ; SCREEN WIDTH (PIXELS)
SCRHEIGH    EQU     480                     ; SCREEN HEIGHT (PIXELS)
SCRIRQ      EQU     1                       ; SCREEN INTERRUPT NUMBER
TIMER    DC.B 'TIMER: ',0   ; "TIMER: " seguido de CR y LF, terminado en NULL
SHIELD      DC.B    $0D, $0A,'SHIELD: ',0
TELEPORT    DC.B    $0D, $0A,'TELEPORT: ',0           
SCRTRAP     EQU     1
TXTFPS      DC.B    $0D, $0A,'GOAL: ' ,0
            DS.W    1
TXT2FPS     DC.B    'ACTUAL: ' ,0
GAMEOVER1   DC.B    $0D, $0A,$0D, $0A,$0D, $0A,$0D, $0A,$0D, $0A,'                                    GAME OVER!',0
GAMEOVER2   DC.B    $0D, $0A,'                     YOU FAILED TO OVERCOME THE CHALLENGE.',0
GAMEOVER3   DC.B    $0D, $0A,'             DUE TO LOSING IN THIS GAME IN THE MIND OF JESUS CHRIST',0
GAMEOVER4   DC.B    $0D, $0A,'                   HE HAS DIED AND WILL NOT BE ABLE TO RESURRECT,',0
GAMEOVER5   DC.B    $0D, $0A,'                     FOLLOWING THE EVENTS OF THE BIBLE.',0
            DS.W    1
SCRTRAP     EQU     1
FPS         EQU     50
;-----------------MOUSE DECLARATIONS CONSTS----------
MOUSETRAP   EQU     2


;----------SHIELD DECLARATIONS CONSTS
SHIELDPOSX  EQU 80
SHIELDPOSY  EQU 0
SHIELDTIMEEN DS.W 1
SHIELDCOOLDOWN DS.W 1
SHIELDINICIO DS.W 1
SHIELDATA  EQU  45



;---------------FILES DECLARATIONS-------------

PIXEL      DS.B 4096


;------------------FILENAMES-----------
FILENAMEPIX   DC.B    'datos_pixeles.bin',0


;------------PLATFORM-----------
CALTURA     EQU 15
CANCHURA    EQU 100

            DS.W    0








