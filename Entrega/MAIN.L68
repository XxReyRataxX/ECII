000041D2  103C 0035                783              MOVE.B  #53,D0                  ; READ DATA TASK
000041D6  243C 00001000            784              MOVE.L  #4096,D2                   ; BYTES TO READ (ONE BY ONE)
000041DC  4E4F                     785              TRAP    #15
000041DE                           786                                 ; PUT A ZERO-TERMINATOR.
000041DE                           787              ; CLOSE THE FILE
000041DE  103C 0038                788              MOVE.B  #56,D0
000041E2  4E4F                     789              TRAP    #15
000041E4  4CDF 0207                790              MOVEM.L (A7)+,D0-D2/A1          ; RESTORE REGISTERS
