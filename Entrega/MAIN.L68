000044FC                          1208  ; =============================================================================
000044FC                          1209  ; DYNAMIC MEMORY MANAGEMENT CONSTANTS (SYSTEM CONSTANTS)
000044FC                          1210  ; =============================================================================
000044FC                          1211  
000044FC  =00000040               1212  DMMBSIZE    EQU     64                      ; BLOCK SIZE (BYTES). POWER OF TWO
000044FC  =00000032               1213  DMMBNUM     EQU     50                      ; NUMBER OF BLOCKS
000044FC  =00000000               1214  DMMSYSID    EQU     0                       ; SYSTEM OWNER ID (MUST BE 0)
000044FC  =00000000               1215  -------------------- end include --------------------
