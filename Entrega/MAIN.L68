00005180                          1227  ; =============================================================================
00005180                          1228  ; DYNAMIC MEMORY MANAGEMENT (SYSTEM CODE)
00005180                          1229  ; DYNAMIC MEMORY IS A SET OF DMMBNUM SLOTS OF DMMBSIZE BYTES EACH ONE.
00005180                          1230  ; DMMBSIZE MUST BE POWER OF TWO. A SLOT HAS:
00005180                          1231  ; - HEADER - 1 WORD. SPECIFIES THE OWNER (0 MEANS OWNED BY SYSTEM)
00005180                          1232  ; - DATA   - DMMBSIZE - 2 BYTES. MAY CONTAIN VARS AND ANY KIND OF DATA RELATED
00005180                          1233  ;            THE THE OWNER. IF OWNER==0, DATA IS MEANINGLESS.
00005180                          1234  ; =============================================================================
00005180                          1235  
00005180                          1236  ; -----------------------------------------------------------------------------
00005180                          1237  DMMINIT
00005180                          1238  ; INITIALIZES THE DYNAMIC MEMORY TO ALL OWNED BY SYSTEM.
00005180                          1239  ; INPUT    - NONE
00005180                          1240  ; OUTPUT   - NONE
00005180                          1241  ; MODIFIES - NONE
00005180                          1242  ; -----------------------------------------------------------------------------
00005180  48E7 8080               1243              MOVEM.L D0/A0,-(A7)
00005184  41F8 4500               1244              LEA     DMMDATA,A0
00005188  303C 0031               1245              MOVE.W  #DMMBNUM-1,D0
0000518C  30BC 0000               1246  .LOOP       MOVE.W  #DMMSYSID,(A0)
00005190  D1FC 00000040           1247              ADD.L   #DMMBSIZE,A0
00005196  51C8 FFF4               1248              DBRA.W  D0,.LOOP
0000519A  4CDF 0101               1249              MOVEM.L (A7)+,D0/A0
0000519E  4E75                    1250              RTS
000051A0                          1251  
000051A0                          1252  ; -----------------------------------------------------------------------------
000051A0                          1253  DMMFIRST
000051A0                          1254  ; SEARCHES THE FIRST MEMORY SLOT NOT OWNED BY SYSTEM AND OUTPUTS A POINTER
000051A0                          1255  ; TO THE CORRESPONDING DATA (SLOT ADDRESS+2)
000051A0                          1256  ; INPUT    - NONE
000051A0                          1257  ; OUTPUT   - A0   : POINTER TO THE DATA OR 0 IF NOT FOUND
000051A0                          1258  ; MODIFIES - NONE (ASIDE OF OUTPUT)
000051A0                          1259  ; -----------------------------------------------------------------------------
000051A0  41F8 4500               1260              LEA     DMMDATA,A0
000051A4  4A58                    1261  DMMFRLOP    TST.W   (A0)+
000051A6  6600 0016               1262              BNE     DMMFRFND
000051AA  D1FC 0000003E           1263              ADD.L   #DMMBSIZE-2,A0
000051B0  B1FC 0000517F           1264  DMMFRCOM    CMP.L   #DMMDATA+DMMBSIZE*DMMBNUM-1,A0
000051B6  6DEC                    1265              BLT     DMMFRLOP
000051B8  207C 00000000           1266              MOVE.L  #0,A0
000051BE  4E75                    1267  DMMFRFND    RTS
000051C0                          1268  
000051C0                          1269  ; -----------------------------------------------------------------------------
000051C0                          1270  DMMNEXT
000051C0                          1271  ; SEARCHES THE NEXT MEMORY SLOT NOT OWNED BY SYSTEM AND OUTPUTS A POINTER
000051C0                          1272  ; TO THE CORRESPONDING DATA (SLOT ADDRESS+2)
000051C0                          1273  ; INPUT    - A0   : POINTER WITHIN THE CURRENT SLOT
000051C0                          1274  ; OUTPUT   - A0   : POINTER TO THE DATA OR 0 IF NOT FOUND
000051C0                          1275  ; MODIFIES - NONE (ASIDE OF OUTPUT)
000051C0                          1276  ; -----------------------------------------------------------------------------
000051C0  2F00                    1277              MOVE.L  D0,-(A7)
000051C2  2008                    1278              MOVE.L  A0,D0
000051C4  C0BC FFFFFFC0           1279              AND.L   #-DMMBSIZE,D0           ; TAKE ADVANTAGE OF ALIGNMENT
000051CA  0680 00000040           1280              ADD.L   #DMMBSIZE,D0
000051D0  2040                    1281              MOVE.L  D0,A0
000051D2  201F                    1282              MOVE.L  (A7)+,D0
000051D4  60DA                    1283              BRA     DMMFRCOM
