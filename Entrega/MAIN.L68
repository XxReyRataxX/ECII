00004198  103C 0035                759              MOVE.B  #53,D0                  ; READ DATA TASK
0000419C  243C 00001000            760              MOVE.L  #4096,D2                   ; BYTES TO READ (ONE BY ONE)
000041A2  4E4F                     761              TRAP    #15
000041A4                           762                                 ; PUT A ZERO-TERMINATOR.
000041A4                           763              ; CLOSE THE FILE
000041A4  103C 0038                764              MOVE.B  #56,D0
000041A8  4E4F                     765              TRAP    #15
000041AA  4CDF 0207                766              MOVEM.L (A7)+,D0-D2/A1          ; RESTORE REGISTERS
