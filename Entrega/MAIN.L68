000051FA  C0BC FFFFFFC0           1313              AND.L   #-DMMBSIZE,D0           ; TAKE ADVANTAGE OF ALIGNMENT
00005200  0680 00000040           1314              ADD.L   #DMMBSIZE,D0
00005206  2040                    1315              MOVE.L  D0,A0
00005208  201F                    1316              MOVE.L  (A7)+,D0
0000520A  60DA                    1317              BRA     DMMFCOM
0000520C                          1318  
0000520C                          1319  ; -----------------------------------------------------------------------------
0000520C                          1320  DMMALLOC
0000520C                          1321  ; SEARCHES THE FIRST FREE (SYS OWNED) SLOT, ASSIGNS TO THE SPECIFIED OWNER
0000520C                          1322  ; AND RETURNS A POINTER TO THE CORRESPONDING DATA (SLOT ADDRESS + 2)
0000520C                          1323  ; INPUT    - D0.W : ID TO ASSIGN
0000520C                          1324  ; OUTPUT   - A0   : POINTER TO THE DATA OR 0 IF NOT FREE SPACE
0000520C                          1325  ; MODIFIES - NONE (ASIDE OF OUTPUT)
0000520C                          1326  ; -----------------------------------------------------------------------------
0000520C  3F00                    1327              MOVE.W  D0,-(A7)
0000520E  4240                    1328              CLR.W   D0
00005210  4EB8 51D6               1329              JSR     DMMFRSTO
00005214  301F                    1330              MOVE.W  (A7)+,D0
00005216  B1FC 00000000           1331              CMP.L   #0,A0
0000521C  6700 0006               1332              BEQ     .END
00005220  3140 FFFE               1333              MOVE.W  D0,-2(A0)
00005224  4E75                    1334  .END        RTS
