000051F8  2008                    1287              MOVE.L  A0,D0
000051FA  C0BC FFFFFFC0           1288              AND.L   #-DMMBSIZE,D0           ; TAKE ADVANTAGE OF ALIGNMENT
00005200  0680 00000040           1289              ADD.L   #DMMBSIZE,D0
00005206  2040                    1290              MOVE.L  D0,A0
00005208  201F                    1291              MOVE.L  (A7)+,D0
0000520A  60DA                    1292              BRA     DMMFCOM
0000520C                          1293  
0000520C                          1294  ; -----------------------------------------------------------------------------
0000520C                          1295  DMMALLOC
0000520C                          1296  ; SEARCHES THE FIRST FREE (SYS OWNED) SLOT, ASSIGNS TO THE SPECIFIED OWNER
0000520C                          1297  ; AND RETURNS A POINTER TO THE CORRESPONDING DATA (SLOT ADDRESS + 2)
0000520C                          1298  ; INPUT    - D0.W : ID TO ASSIGN
0000520C                          1299  ; OUTPUT   - A0   : POINTER TO THE DATA OR 0 IF NOT FREE SPACE
0000520C                          1300  ; MODIFIES - NONE (ASIDE OF OUTPUT)
