00005180                          1200              
00005180                          1201              INCLUDE "DMMCODE.X68"
00005180                          1202  ; =============================================================================
00005180                          1203  ; DYNAMIC MEMORY MANAGEMENT (SYSTEM CODE)
00005180                          1204  ; DYNAMIC MEMORY IS A SET OF DMMBNUM SLOTS OF DMMBSIZE BYTES EACH ONE.
00005180                          1205  ; DMMBSIZE MUST BE POWER OF TWO. A SLOT HAS:
00005180                          1206  ; - HEADER - 1 WORD. SPECIFIES THE OWNER (0 MEANS OWNED BY SYSTEM)
00005180                          1207  ; - DATA   - DMMBSIZE - 2 BYTES. MAY CONTAIN VARS AND ANY KIND OF DATA RELATED
00005180                          1208  ;            THE THE OWNER. IF OWNER==0, DATA IS MEANINGLESS.
00005180                          1209  ; =============================================================================
00005180                          1210  
00005180                          1211  ; -----------------------------------------------------------------------------
00005180                          1212  DMMINIT
00005180                          1213  ; INITIALIZES THE DYNAMIC MEMORY TO ALL OWNED BY SYSTEM.
00005180                          1214  ; INPUT    - NONE
00005180                          1215  ; OUTPUT   - NONE
00005180                          1216  ; MODIFIES - NONE
00005180                          1217  ; -----------------------------------------------------------------------------
00005180  48E7 8080               1218              MOVEM.L D0/A0,-(A7)
00005184  41F8 4500               1219              LEA     DMMDATA,A0
00005188  303C 0031               1220              MOVE.W  #DMMBNUM-1,D0
0000518C  30BC 0000               1221  .LOOP       MOVE.W  #DMMSYSID,(A0)
00005190  D1FC 00000040           1222              ADD.L   #DMMBSIZE,A0
00005196  51C8 FFF4               1223              DBRA.W  D0,.LOOP
0000519A  4CDF 0101               1224              MOVEM.L (A7)+,D0/A0
0000519E  4E75                    1225              RTS
000051A0                          1226  
000051A0                          1227  ; -----------------------------------------------------------------------------
000051A0                          1228  DMMFIRST
000051A0                          1229  ; SEARCHES THE FIRST MEMORY SLOT NOT OWNED BY SYSTEM AND OUTPUTS A POINTER
000051A0                          1230  ; TO THE CORRESPONDING DATA (SLOT ADDRESS+2)
000051A0                          1231  ; INPUT    - NONE
000051A0                          1232  ; OUTPUT   - A0   : POINTER TO THE DATA OR 0 IF NOT FOUND
000051A0                          1233  ; MODIFIES - NONE (ASIDE OF OUTPUT)
000051A0                          1234  ; -----------------------------------------------------------------------------
000051A0  41F8 4500               1235              LEA     DMMDATA,A0
000051A4  4A58                    1236  DMMFRLOP    TST.W   (A0)+
000051A6  6600 0016               1237              BNE     DMMFRFND
000051AA  D1FC 0000003E           1238              ADD.L   #DMMBSIZE-2,A0
000051B0  B1FC 0000517F           1239  DMMFRCOM    CMP.L   #DMMDATA+DMMBSIZE*DMMBNUM-1,A0
000051B6  6DEC                    1240              BLT     DMMFRLOP
000051B8  207C 00000000           1241              MOVE.L  #0,A0
000051BE  4E75                    1242  DMMFRFND    RTS
000051C0                          1243  
000051C0                          1244  ; -----------------------------------------------------------------------------
000051C0                          1245  DMMNEXT
000051C0                          1246  ; SEARCHES THE NEXT MEMORY SLOT NOT OWNED BY SYSTEM AND OUTPUTS A POINTER
000051C0                          1247  ; TO THE CORRESPONDING DATA (SLOT ADDRESS+2)
000051C0                          1248  ; INPUT    - A0   : POINTER WITHIN THE CURRENT SLOT
000051C0                          1249  ; OUTPUT   - A0   : POINTER TO THE DATA OR 0 IF NOT FOUND
000051C0                          1250  ; MODIFIES - NONE (ASIDE OF OUTPUT)
000051C0                          1251  ; -----------------------------------------------------------------------------
000051C0  2F00                    1252              MOVE.L  D0,-(A7)
000051C2  2008                    1253              MOVE.L  A0,D0
000051C4  C0BC FFFFFFC0           1254              AND.L   #-DMMBSIZE,D0           ; TAKE ADVANTAGE OF ALIGNMENT
000051CA  0680 00000040           1255              ADD.L   #DMMBSIZE,D0
000051D0  2040                    1256              MOVE.L  D0,A0
000051D2  201F                    1257              MOVE.L  (A7)+,D0
000051D4  60DA                    1258              BRA     DMMFRCOM
