000041C0                           760  FILLOAD
000041C0                           761  ; LOADS AN FILE FROM DISK TO MEMORY
000041C0                           762  ; INPUT    : A0 - DESTINATION ADDR. WITH ENOUGH SPACE AVAILABLE.
000041C0                           763  ;            A1 - POINTER TO FILE NAME
000041C0                           764  ; OUTPUT   : NONE
000041C0                           765  ; MODIFIES : NONE
000041C0                           766  ; NOTE     : THE READ DATA LOOP READS 1 BYTE AT A TIME TO ENSURE ALL FILES CAN
000041C0                           767  ;            BE LOADED. HOWEVER, IF THE FILE SIZE IS KNOWN BEFOREHAND, NO LOOP
000041C0                           768  ;            WOULD BE NECESSARY AND A SINGLE CALL TO TRAP #15 TASK 53 WOULD READ
000041C0                           769  ;            THE WHOLE FILE AS LONG AS THE FILE SIZE IS PLACED INTO D2.L.
000041C0                           770  ; NOTE     : THE ZERO-TERMINATOR (JUST BEFORE CLOSE THE FILE) IS A REQUIREMENT
000041C0                           771  ;            FOR TEXT-FILES IF THE TEXT IS TO BE PRINTED. FOR OTHER USES, IT
000041C0                           772  ;            CAN BE REMOVED.
000041C0                           773  ; ------------------------------------------------------------------------------
000041C0  48E7 E040                774              MOVEM.L D0-D2/A1,-(A7)          ; SAVE REGISTERS
000041C4                           775              ; CLOSE ALL FILES
000041C4  103C 0032                776              MOVE.B  #50,D0
000041C8  4E4F                     777              TRAP    #15
000041CA                           778              ; OPEN FILE (ASSUMES A1 POINTS TO FILENAME)
000041CA  103C 0033                779              MOVE.B  #51,D0
000041CE  4E4F                     780              TRAP    #15                     ; D1.L:=FILE HANDLER
000041D0                           781              ; READ DATA
