000072C0                          1475              INCLUDE "DMMCODE.X68"
000072C0                          1476  ; =============================================================================
000072C0                          1477  ; DYNAMIC MEMORY MANAGEMENT (SYSTEM CODE)
000072C0                          1478  ; DYNAMIC MEMORY IS A SET OF DMMBNUM SLOTS OF DMMBSIZE BYTES EACH ONE.
000072C0                          1479  ; DMMBSIZE MUST BE POWER OF TWO. A SLOT HAS:
000072C0                          1480  ; - HEADER - 1 WORD. SPECIFIES THE OWNER (0 MEANS OWNED BY SYSTEM)
000072C0                          1481  ; - DATA   - DMMBSIZE - 2 BYTES. MAY CONTAIN VARS AND ANY KIND OF DATA RELATED
000072C0                          1482  ;            THE THE OWNER. IF OWNER==0, DATA IS MEANINGLESS.
000072C0                          1483  ; =============================================================================
000072C0                          1484  
000072C0                          1485  ; -----------------------------------------------------------------------------
000072C0                          1486  DMMINIT
000072C0                          1487  ; INITIALIZES THE DYNAMIC MEMORY TO ALL OWNED BY SYSTEM.
000072C0                          1488  ; INPUT    - NONE
000072C0                          1489  ; OUTPUT   - NONE
000072C0                          1490  ; MODIFIES - NONE
000072C0                          1491  ; -----------------------------------------------------------------------------
000072C0  48E7 8080               1492              MOVEM.L D0/A0,-(A7)
000072C4  41F8 6640               1493              LEA     DMMDATA,A0
000072C8  303C 0031               1494              MOVE.W  #DMMBNUM-1,D0
000072CC  30BC 0000               1495  .LOOP       MOVE.W  #DMMSYSID,(A0)
000072D0  D1FC 00000040           1496              ADD.L   #DMMBSIZE,A0
000072D6  51C8 FFF4               1497              DBRA.W  D0,.LOOP
000072DA  4CDF 0101               1498              MOVEM.L (A7)+,D0/A0
000072DE  4E75                    1499              RTS
000072E0                          1500  
000072E0                          1501  ; -----------------------------------------------------------------------------
000072E0                          1502  DMMFIRST
000072E0                          1503  ; SEARCHES THE FIRST MEMORY SLOT NOT OWNED BY SYSTEM AND OUTPUTS A POINTER
000072E0                          1504  ; TO THE CORRESPONDING DATA (SLOT ADDRESS+2)
000072E0                          1505  ; INPUT    - NONE
000072E0                          1506  ; OUTPUT   - A0   : POINTER TO THE DATA OR 0 IF NOT FOUND
000072E0                          1507  ; MODIFIES - NONE (ASIDE OF OUTPUT)
000072E0                          1508  ; -----------------------------------------------------------------------------
000072E0  41F8 6640               1509              LEA     DMMDATA,A0
000072E4  4A58                    1510  DMMFRLOP    TST.W   (A0)+
000072E6  6600 0016               1511              BNE     DMMFRFND
000072EA  D1FC 0000003E           1512              ADD.L   #DMMBSIZE-2,A0
000072F0  B1FC 000072BF           1513  DMMFRCOM    CMP.L   #DMMDATA+DMMBSIZE*DMMBNUM-1,A0
000072F6  6DEC                    1514              BLT     DMMFRLOP
000072F8  207C 00000000           1515              MOVE.L  #0,A0
000072FE  4E75                    1516  DMMFRFND    RTS
00007300                          1517  
00007300                          1518  ; -----------------------------------------------------------------------------
00007300                          1519  DMMNEXT
00007300                          1520  ; SEARCHES THE NEXT MEMORY SLOT NOT OWNED BY SYSTEM AND OUTPUTS A POINTER
00007300                          1521  ; TO THE CORRESPONDING DATA (SLOT ADDRESS+2)
00007300                          1522  ; INPUT    - A0   : POINTER WITHIN THE CURRENT SLOT
00007300                          1523  ; OUTPUT   - A0   : POINTER TO THE DATA OR 0 IF NOT FOUND
00007300                          1524  ; MODIFIES - NONE (ASIDE OF OUTPUT)
00007300                          1525  ; -----------------------------------------------------------------------------
00007300  2F00                    1526              MOVE.L  D0,-(A7)
00007302  2008                    1527              MOVE.L  A0,D0
00007304  C0BC FFFFFFC0           1528              AND.L   #-DMMBSIZE,D0           ; TAKE ADVANTAGE OF ALIGNMENT
0000730A  0680 00000040           1529              ADD.L   #DMMBSIZE,D0
00007310  2040                    1530              MOVE.L  D0,A0
00007312  201F                    1531              MOVE.L  (A7)+,D0
00007314  60DA                    1532              BRA     DMMFRCOM
00007316                          1533  
00007316                          1534  ; -----------------------------------------------------------------------------
00007316                          1535  DMMFRSTO
00007316                          1536  ; SEARCHES THE FIRST MEMORY SLOT WITH THE SPECIFIED ID AND OUTPUTS A POINTER
00007316                          1537  ; TO THE CORRESPONDING DATA (SLOT ADDRESS+2)
00007316                          1538  ; INPUT    - D0.W : ID TO SEARCH
00007316                          1539  ; OUTPUT   - A0   : POINTER TO THE DATA OR 0 IF NOT FOUND
00007316                          1540  ; MODIFIES - NONE (ASIDE OF OUTPUT)
00007316                          1541  ; -----------------------------------------------------------------------------
00007316  41F8 6640               1542              LEA     DMMDATA,A0
0000731A  B058                    1543  DMMFLOOP    CMP.W   (A0)+,D0
0000731C  6700 0016               1544              BEQ     DMMFFND
00007320  D1FC 0000003E           1545              ADD.L   #DMMBSIZE-2,A0
00007326  B1FC 000072BF           1546  DMMFCOM     CMP.L   #DMMDATA+DMMBSIZE*DMMBNUM-1,A0
0000732C  6DEC                    1547              BLT     DMMFLOOP
0000732E  207C 00000000           1548              MOVE.L  #0,A0
00007334  4E75                    1549  DMMFFND     RTS
00007336                          1550  
00007336                          1551  ; -----------------------------------------------------------------------------
00007336                          1552  DMMNEXTO
00007336                          1553  ; SEARCHES THE NEXT MEMORY SLOT WITH THE SPECIFIED ID AND OUTPUTS A POINTER
00007336                          1554  ; TO THE CORRESPONDING DATA (SLOT ADDRESS+2)
00007336                          1555  ; INPUT    - D0.W : ID TO SEARCH
00007336                          1556  ;            A0   : POINTER WITHIN THE CURRENT SLOT
00007336                          1557  ; OUTPUT   - A0   : POINTER TO THE DATA OR 0 IF NOT FOUND
00007336                          1558  ; MODIFIES - NONE (ASIDE OF OUTPUT)
00007336                          1559  ; -----------------------------------------------------------------------------
00007336  2F00                    1560              MOVE.L  D0,-(A7)
00007338  2008                    1561              MOVE.L  A0,D0
0000733A  C0BC FFFFFFC0           1562              AND.L   #-DMMBSIZE,D0           ; TAKE ADVANTAGE OF ALIGNMENT
00007340  0680 00000040           1563              ADD.L   #DMMBSIZE,D0
00007346  2040                    1564              MOVE.L  D0,A0
00007348  201F                    1565              MOVE.L  (A7)+,D0
0000734A  60DA                    1566              BRA     DMMFCOM
0000734C                          1567  
0000734C                          1568  ; -----------------------------------------------------------------------------
0000734C                          1569  DMMALLOC
0000734C                          1570  ; SEARCHES THE FIRST FREE (SYS OWNED) SLOT, ASSIGNS TO THE SPECIFIED OWNER
0000734C                          1571  ; AND RETURNS A POINTER TO THE CORRESPONDING DATA (SLOT ADDRESS + 2)
0000734C                          1572  ; INPUT    - D0.W : ID TO ASSIGN
0000734C                          1573  ; OUTPUT   - A0   : POINTER TO THE DATA OR 0 IF NOT FREE SPACE
0000734C                          1574  ; MODIFIES - NONE (ASIDE OF OUTPUT)
0000734C                          1575  ; -----------------------------------------------------------------------------
0000734C  3F00                    1576              MOVE.W  D0,-(A7)
0000734E  4240                    1577              CLR.W   D0
00007350  4EB8 7316               1578              JSR     DMMFRSTO
00007354  301F                    1579              MOVE.W  (A7)+,D0
00007356  B1FC 00000000           1580              CMP.L   #0,A0
0000735C  6700 0006               1581              BEQ     .END
00007360  3140 FFFE               1582              MOVE.W  D0,-2(A0)
00007364  4E75                    1583  .END        RTS
00007366                          1584  
00007366                          1585  ; -----------------------------------------------------------------------------
00007366                          1586  DMMFREE
00007366                          1587  ; FREES THE SLOT TO WHICH THE PROVIDED POINTER BELONGS BY SETTING ITS OWNED TO
00007366                          1588  ; SYSTEM (0)
00007366                          1589  ; INPUT    - A0   : POINTER BELONGING TO THE SLOT TO FREE
00007366                          1590  ; OUTPUT   - NONE
00007366                          1591  ; MODIFIES - NONE
00007366                          1592  ; -----------------------------------------------------------------------------
00007366  48E7 8080               1593              MOVEM.L D0/A0,-(A7)
0000736A  2008                    1594              MOVE.L  A0,D0
0000736C  C0BC FFFFFFC0           1595              AND.L   #-DMMBSIZE,D0           ; TAKE ADVANTAGE OF ALIGNMENT
00007372  2040                    1596              MOVE.L  D0,A0
00007374  4250                    1597              CLR.W   (A0)
00007376  4CDF 0101               1598              MOVEM.L (A7)+,D0/A0
0000737A  4E75                    1599              RTS
