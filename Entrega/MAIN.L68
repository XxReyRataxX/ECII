000051E0  D1FC 0000003E           1296              ADD.L   #DMMBSIZE-2,A0
000051E6  B1FC 0000517F           1297  DMMFCOM     CMP.L   #DMMDATA+DMMBSIZE*DMMBNUM-1,A0
000051EC  6DEC                    1298              BLT     DMMFLOOP
