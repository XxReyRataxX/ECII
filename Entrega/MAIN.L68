00006634                          1456              INCLUDE "DMMCONST.X68"
00006634                          1457  ; =============================================================================
00006634                          1458  ; DYNAMIC MEMORY MANAGEMENT CONSTANTS (SYSTEM CONSTANTS)
00006634                          1459  ; =============================================================================
00006634                          1460  
00006634  =00000040               1461  DMMBSIZE    EQU     64                      ; BLOCK SIZE (BYTES). POWER OF TWO
00006634  =00000032               1462  DMMBNUM     EQU     50                      ; NUMBER OF BLOCKS
00006634  =00000000               1463  DMMSYSID    EQU     0                       ; SYSTEM OWNER ID (MUST BE 0)
00006634  =00000000               1464  -------------------- end include --------------------
00006634                          1465              INCLUDE "DMMVARS.X68"
00006634                          1466  ; =============================================================================
00006634                          1467  ; DYNAMIC MEMORY MANAGEMENT VARIABLES (SYSTEM VARIABLES)
00006634                          1468  ; =============================================================================
00006634                          1469  
00006640                          1470              ORG     (*+DMMBSIZE-1)&-DMMBSIZE ; ALIGN TO DMMBSIZE
00006640                          1471  DMMDATA     DS.B    DMMBSIZE*DMMBNUM        ; DYNAMIC MEMORY ALLOCATION SPACE
000072C0                          1472              DS.W    0                       ; JUST IN CASE (SIZE IS POW OF TWO)
