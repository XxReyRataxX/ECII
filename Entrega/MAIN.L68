00004084                           807  ; =============================================================================
00004084                           808  ; DYNAMIC MEMORY MANAGEMENT CONSTANTS (SYSTEM CONSTANTS)
00004084                           809  ; =============================================================================
00004084                           810  
00004084  =00000040                811  DMMBSIZE    EQU     64                      ; BLOCK SIZE (BYTES). POWER OF TWO
00004084  =00000032                812  DMMBNUM     EQU     50                      ; NUMBER OF BLOCKS
00004084  =00000000                813  DMMSYSID    EQU     0                       ; SYSTEM OWNER ID (MUST BE 0)
00004084  =00000000                814  -------------------- end include --------------------
00004084                           815              INCLUDE "DMMVARS.X68"
00004084                           816  ; =============================================================================
00004084                           817  ; DYNAMIC MEMORY MANAGEMENT VARIABLES (SYSTEM VARIABLES)
00004084                           818  ; =============================================================================
00004084                           819  
000040C0                           820              ORG     (*+DMMBSIZE-1)&-DMMBSIZE ; ALIGN TO DMMBSIZE
000040C0                           821  DMMDATA     DS.B    DMMBSIZE*DMMBNUM        ; DYNAMIC MEMORY ALLOCATION SPACE
00004D40                           822              DS.W    0                       ; JUST IN CASE (SIZE IS POW OF TWO)
00004D40                           823  -------------------- end include --------------------
00004D40                           824              
00004D40                           825              INCLUDE "DMMCODE.X68"
00004D40                           826  ; =============================================================================
00004D40                           827  ; DYNAMIC MEMORY MANAGEMENT (SYSTEM CODE)
00004D40                           828  ; DYNAMIC MEMORY IS A SET OF DMMBNUM SLOTS OF DMMBSIZE BYTES EACH ONE.
00004D40                           829  ; DMMBSIZE MUST BE POWER OF TWO. A SLOT HAS:
00004D40                           830  ; - HEADER - 1 WORD. SPECIFIES THE OWNER (0 MEANS OWNED BY SYSTEM)
00004D40                           831  ; - DATA   - DMMBSIZE - 2 BYTES. MAY CONTAIN VARS AND ANY KIND OF DATA RELATED
00004D40                           832  ;            THE THE OWNER. IF OWNER==0, DATA IS MEANINGLESS.
00004D40                           833  ; =============================================================================
00004D40                           834  
00004D40                           835  ; -----------------------------------------------------------------------------
00004D40                           836  DMMINIT
00004D40                           837  ; INITIALIZES THE DYNAMIC MEMORY TO ALL OWNED BY SYSTEM.
00004D40                           838  ; INPUT    - NONE
00004D40                           839  ; OUTPUT   - NONE
00004D40                           840  ; MODIFIES - NONE
00004D40                           841  ; -----------------------------------------------------------------------------
00004D40  48E7 8080                842              MOVEM.L D0/A0,-(A7)
00004D44  41F8 40C0                843              LEA     DMMDATA,A0
00004D48  303C 0031                844              MOVE.W  #DMMBNUM-1,D0
00004D4C  30BC 0000                845  .LOOP       MOVE.W  #DMMSYSID,(A0)
00004D50  D1FC 00000040            846              ADD.L   #DMMBSIZE,A0
00004D56  51C8 FFF4                847              DBRA.W  D0,.LOOP
00004D5A  4CDF 0101                848              MOVEM.L (A7)+,D0/A0
00004D5E  4E75                     849              RTS
00004D60                           850  
00004D60                           851  ; -----------------------------------------------------------------------------
00004D60                           852  DMMFIRST
00004D60                           853  ; SEARCHES THE FIRST MEMORY SLOT NOT OWNED BY SYSTEM AND OUTPUTS A POINTER
00004D60                           854  ; TO THE CORRESPONDING DATA (SLOT ADDRESS+2)
00004D60                           855  ; INPUT    - NONE
00004D60                           856  ; OUTPUT   - A0   : POINTER TO THE DATA OR 0 IF NOT FOUND
00004D60                           857  ; MODIFIES - NONE (ASIDE OF OUTPUT)
00004D60                           858  ; -----------------------------------------------------------------------------
00004D60  41F8 40C0                859              LEA     DMMDATA,A0
00004D64  4A58                     860  DMMFRLOP    TST.W   (A0)+
00004D66  6600 0016                861              BNE     DMMFRFND
00004D6A  D1FC 0000003E            862              ADD.L   #DMMBSIZE-2,A0
00004D70  B1FC 00004D3F            863  DMMFRCOM    CMP.L   #DMMDATA+DMMBSIZE*DMMBNUM-1,A0
00004D76  6DEC                     864              BLT     DMMFRLOP
00004D78  207C 00000000            865              MOVE.L  #0,A0
00004D7E  4E75                     866  DMMFRFND    RTS
00004D80                           867  
00004D80                           868  ; -----------------------------------------------------------------------------
00004D80                           869  DMMNEXT
00004D80                           870  ; SEARCHES THE NEXT MEMORY SLOT NOT OWNED BY SYSTEM AND OUTPUTS A POINTER
00004D80                           871  ; TO THE CORRESPONDING DATA (SLOT ADDRESS+2)
00004D80                           872  ; INPUT    - A0   : POINTER WITHIN THE CURRENT SLOT
00004D80                           873  ; OUTPUT   - A0   : POINTER TO THE DATA OR 0 IF NOT FOUND
00004D80                           874  ; MODIFIES - NONE (ASIDE OF OUTPUT)
00004D80                           875  ; -----------------------------------------------------------------------------
00004D80  2F00                     876              MOVE.L  D0,-(A7)
00004D82  2008                     877              MOVE.L  A0,D0
00004D84  C0BC FFFFFFC0            878              AND.L   #-DMMBSIZE,D0           ; TAKE ADVANTAGE OF ALIGNMENT
00004D8A  0680 00000040            879              ADD.L   #DMMBSIZE,D0
00004D90  2040                     880              MOVE.L  D0,A0
00004D92  201F                     881              MOVE.L  (A7)+,D0
00004D94  60DA                     882              BRA     DMMFRCOM
00004D96                           883  
00004D96                           884  ; -----------------------------------------------------------------------------
00004D96                           885  DMMFRSTO
00004D96                           886  ; SEARCHES THE FIRST MEMORY SLOT WITH THE SPECIFIED ID AND OUTPUTS A POINTER
00004D96                           887  ; TO THE CORRESPONDING DATA (SLOT ADDRESS+2)
00004D96                           888  ; INPUT    - D0.W : ID TO SEARCH
00004D96                           889  ; OUTPUT   - A0   : POINTER TO THE DATA OR 0 IF NOT FOUND
00004D96                           890  ; MODIFIES - NONE (ASIDE OF OUTPUT)
00004D96                           891  ; -----------------------------------------------------------------------------
00004D96  41F8 40C0                892              LEA     DMMDATA,A0
00004D9A  B058                     893  DMMFLOOP    CMP.W   (A0)+,D0
00004D9C  6700 0016                894              BEQ     DMMFFND
00004DA0  D1FC 0000003E            895              ADD.L   #DMMBSIZE-2,A0
00004DA6  B1FC 00004D3F            896  DMMFCOM     CMP.L   #DMMDATA+DMMBSIZE*DMMBNUM-1,A0
00004DAC  6DEC                     897              BLT     DMMFLOOP
00004DAE  207C 00000000            898              MOVE.L  #0,A0
00004DB4  4E75                     899  DMMFFND     RTS
00004DB6                           900  
00004DB6                           901  ; -----------------------------------------------------------------------------
00004DB6                           902  DMMNEXTO
00004DB6                           903  ; SEARCHES THE NEXT MEMORY SLOT WITH THE SPECIFIED ID AND OUTPUTS A POINTER
00004DB6                           904  ; TO THE CORRESPONDING DATA (SLOT ADDRESS+2)
00004DB6                           905  ; INPUT    - D0.W : ID TO SEARCH
00004DB6                           906  ;            A0   : POINTER WITHIN THE CURRENT SLOT
00004DB6                           907  ; OUTPUT   - A0   : POINTER TO THE DATA OR 0 IF NOT FOUND
00004DB6                           908  ; MODIFIES - NONE (ASIDE OF OUTPUT)
00004DB6                           909  ; -----------------------------------------------------------------------------
00004DB6  2F00                     910              MOVE.L  D0,-(A7)
00004DB8  2008                     911              MOVE.L  A0,D0
00004DBA  C0BC FFFFFFC0            912              AND.L   #-DMMBSIZE,D0           ; TAKE ADVANTAGE OF ALIGNMENT
00004DC0  0680 00000040            913              ADD.L   #DMMBSIZE,D0
00004DC6  2040                     914              MOVE.L  D0,A0
00004DC8  201F                     915              MOVE.L  (A7)+,D0
00004DCA  60DA                     916              BRA     DMMFCOM
00004DCC                           917  
00004DCC                           918  ; -----------------------------------------------------------------------------
00004DCC                           919  DMMALLOC
00004DCC                           920  ; SEARCHES THE FIRST FREE (SYS OWNED) SLOT, ASSIGNS TO THE SPECIFIED OWNER
00004DCC                           921  ; AND RETURNS A POINTER TO THE CORRESPONDING DATA (SLOT ADDRESS + 2)
00004DCC                           922  ; INPUT    - D0.W : ID TO ASSIGN
00004DCC                           923  ; OUTPUT   - A0   : POINTER TO THE DATA OR 0 IF NOT FREE SPACE
00004DCC                           924  ; MODIFIES - NONE (ASIDE OF OUTPUT)
00004DCC                           925  ; -----------------------------------------------------------------------------
00004DCC  3F00                     926              MOVE.W  D0,-(A7)
00004DCE  4240                     927              CLR.W   D0
00004DD0  4EB8 4D96                928              JSR     DMMFRSTO
00004DD4  301F                     929              MOVE.W  (A7)+,D0
00004DD6  B1FC 00000000            930              CMP.L   #0,A0
00004DDC  6700 0006                931              BEQ     .END
00004DE0  3140 FFFE                932              MOVE.W  D0,-2(A0)
00004DE4  4E75                     933  .END        RTS
00004DE6                           934  
00004DE6                           935  ; -----------------------------------------------------------------------------
00004DE6                           936  DMMFREE
00004DE6                           937  ; FREES THE SLOT TO WHICH THE PROVIDED POINTER BELONGS BY SETTING ITS OWNED TO
00004DE6                           938  ; SYSTEM (0)
00004DE6                           939  ; INPUT    - A0   : POINTER BELONGING TO THE SLOT TO FREE
00004DE6                           940  ; OUTPUT   - NONE
00004DE6                           941  ; MODIFIES - NONE
00004DE6                           942  ; -----------------------------------------------------------------------------
00004DE6  48E7 8080                943              MOVEM.L D0/A0,-(A7)
00004DEA  2008                     944              MOVE.L  A0,D0
00004DEC  C0BC FFFFFFC0            945              AND.L   #-DMMBSIZE,D0           ; TAKE ADVANTAGE OF ALIGNMENT
00004DF2  2040                     946              MOVE.L  D0,A0
00004DF4  4250                     947              CLR.W   (A0)
00004DF6  4CDF 0101                948              MOVEM.L (A7)+,D0/A0
00004DFA  4E75                     949              RTS
