00003CD8  1038 3C20                306              MOVE.B  (KBDVAL),D0             ; COMPUTE EDGE.
00003CDC  4600                     307              NOT.B   D0                      ; EDGE=NOT(PREVIOUS) AND CURRENT.
00003CDE  C002                     308              AND.B   D2,D0
00003CE0  11C2 3C20                309              MOVE.B  D2,(KBDVAL)             ; STORE VALUES (PRESS AND EDGE)
00003CE4  11C0 3C21                310              MOVE.B  D0,(KBDEDGE)
