00005226                          1342  ; MODIFIES - NONE
00005226                          1343  ; -----------------------------------------------------------------------------
00005226  48E7 8080               1344              MOVEM.L D0/A0,-(A7)
0000522A  2008                    1345              MOVE.L  A0,D0
0000522C  C0BC FFFFFFC0           1346              AND.L   #-DMMBSIZE,D0           ; TAKE ADVANTAGE OF ALIGNMENT
00005232  2040                    1347              MOVE.L  D0,A0
00005234  4250                    1348              CLR.W   (A0)
00005236  4CDF 0101               1349              MOVEM.L (A7)+,D0/A0
0000523A  4E75                    1350              RTS
