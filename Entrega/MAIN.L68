000044C2                          1183  ; =============================================================================
000044C2                          1184  ; DYNAMIC MEMORY MANAGEMENT CONSTANTS (SYSTEM CONSTANTS)
000044C2                          1185  ; =============================================================================
000044C2                          1186  
000044C2  =00000040               1187  DMMBSIZE    EQU     64                      ; BLOCK SIZE (BYTES). POWER OF TWO
000044C2  =00000032               1188  DMMBNUM     EQU     50                      ; NUMBER OF BLOCKS
000044C2  =00000000               1189  DMMSYSID    EQU     0                       ; SYSTEM OWNER ID (MUST BE 0)
000044C2  =00000000               1190  -------------------- end include --------------------
