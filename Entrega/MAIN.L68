00005214  301F                    1305              MOVE.W  (A7)+,D0
00005216  B1FC 00000000           1306              CMP.L   #0,A0
0000521C  6700 0006               1307              BEQ     .END
00005220  3140 FFFE               1308              MOVE.W  D0,-2(A0)
00005224  4E75                    1309  .END        RTS
