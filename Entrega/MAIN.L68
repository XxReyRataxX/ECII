00003E14  103C 0035                486              MOVE.B  #53,D0                  ; READ DATA TASK
00003E18  243C 00001000            487              MOVE.L  #4096,D2                   ; BYTES TO READ (ONE BY ONE)
00003E1E  4E4F                     488              TRAP    #15
00003E20                           489                                 ; PUT A ZERO-TERMINATOR.
00003E20                           490              ; CLOSE THE FILE
00003E20  103C 0038                491              MOVE.B  #56,D0
00003E24  4E4F                     492              TRAP    #15
00003E26  4CDF 0207                493              MOVEM.L (A7)+,D0-D2/A1          ; RESTORE REGISTERS
00003E2A  4E75                     494              RTS
