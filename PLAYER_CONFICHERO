           JSR PLRINIT
           CLR.L D2
.LOOP       
            TRAP    #MOUSETRAP
	TRAP    #KBDTRAP                ; READ KEYBOARD
	JSR AGLUPD
            JSR     PLRUPD
            
            JSR AGLPLOT
            JSR     DIBUJAR
            LEA BALINIT,A1
            LEA BALUPD, A2
            LEA BALPLOT,A3
             MOVE.W #1,D0
             JSR      AGLADD
          
           
           
            
.WINT       TST.B   (SCRINTCT)              ; WAIT FOR INTERRUPT
            BEQ     .WINT
            CLR.B   (SCRINTCT)
            CLR.L D6
            MOVE.B (SCRCYCCT),D6
            CMP #50,D6
            BNE .YA
            ADDQ.W #1,(VTIMER)
            CLR.B   (SCRCYCCT)
.YA           
