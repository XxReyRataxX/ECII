; NOTE     - IT IS JUST A WRAPPER FOR DMMFREE
; -----------------------------------------------------------------------------

           
; ==============================================================================
; BALL MANAGEMENT (AGENT)
; BALPOSX (W)  (A0)
; BALPOSY (W) 2(A0)
; BALVELX (W) 4(A0)
; BALVELY (W) 6(A0)
; ==============================================================================
            
; ------------------------------------------------------------------------------
BALINIT
; INITIALIZE BALL.
; INPUT    : A0 POINTER TO THE INSTANCE VARIABLES 
; OUTPUT   : NONE
; MODIFIES : NONE
; ------------------------------------------------------------------------------
            MOVEM.L D0-A2,-(A7),-(A7)
            CLR D2
            JSR     UTLRAND
            LEA     .VELVEC,A1
            LEA     .POSVEC,A2
            AND.L   #$0000000C,D0
            MOVE.L  (A2,D0),(A0)
            
            
            MOVE.W D0,D1  
            CLR.L D0
            JSR     UTLRAND
            BTST #0, D0        ; Comprueba el quinto bit (bit 4) de D0.
            BNE .BitIsClear     ; Salta si el quinto bit es 0.
            MOVE.W D1,D2
            CMP #12,D2
            BEQ .BitIsClear
            ADDQ.W #4,D1
            
.BitIsClear  
            
            MOVE.L  (A1,D1),4(A0)
            
            
            MOVEM.L (A7)+,D0-A2

            RTS

.VELVEC     DC.W    BALVEL,-BALVEL      ;0
            DC.W    BALVEL,BALVEL       ;4
            DC.W    -BALVEL,-BALVEL     ;8
            DC.W    -BALVEL,BALVEL          ;12
.POSVEC     DC.W    0,160     ;0
            DC.W    0,320       ;4
            DC.W    SCRWIDTH,160      ;8
            DC.W    SCRWIDTH,320       ;12

            
; ------------------------------------------------------------------------------
BALUPD
; UPDATES THE BALL.
; INPUT    : A0 POINTER TO THE INSTANCE VARIABLES  
; OUTPUT   : NONE
; MODIFIES : NONE
; ------------------------------------------------------------------------------

            MOVEM.W D0-D2,-(A7)
            LEA BALPOSX,A0

            ; UPDATE BALL COORDINATES
            MOVE.W  (A0),D0
            MOVE.W  2(A0),D1
            
            ADD.W   4(A0),D0
            ADD.W   6(A0),D1
            
            
          ; CHECK HORIZONTAL COLLISIONS
            CMP.W   #SCRWIDTH-BALRAD,D0
            BGT     .COLRGT
            CMP.W   #BALRAD,D0
            BLT     .COLLFT
            
            ; CHECK VERTICAL COLLISIONS
.CHKVERT    CMP.W   #SCRHEIGH-BALRAD,D1
            BGT     .COLBOT
            CMP.W   #BALRAD,D1
            BLT     .COLTOP
            BRA     .PLRCOLISION
            
            ; RIGHT SIDE COLLISION
.COLRGT    NEG.W   4(A0)
            MOVE.W  #SCRWIDTH-BALRAD,D0
            BRA     .CHKVERT
            
            ; LEFT SIDE COLLISION
.COLLFT     NEG.W   4(A0)
            MOVE.W #BALRAD,D0
            BRA     .CHKVERT

            ; BOTTOM COLLISION
.COLBOT      NEG.W   6(A0)
            MOVE.W  #SCRHEIGH-BALRAD,D1
            BRA     .PLRCOLISION
            
            ; TOP COLLISION
.COLTOP      NEG.W   6(A0)
            MOVE.W  #BALRAD,D1
            
.PLRCOLISION
            MOVE.W (PLRPOSX),D2
            MOVE.W (PLRPOSY),D3
            MOVE.W D0,D4
            ADD.W #BALRAD,D4
            MOVE.W (PLRWIDTH),D5
            
            MOVE.W D1,D5
            ADD.W #BALRAD,D5
            MOVE.W (PLRHEIGH),D7
            
            JSR UTLCHCOL
            CMP #0,D0
            BNE .DONE2
           
            
            
            


            

            ; STORE POSITION
.DONE       MOVE.W  D0,(A0)
            MOVE.W  D1,2(A0)

            MOVEM.W (A7)+,D0-D2
             RTS
            
.DONE2
            SIMHALT

            
